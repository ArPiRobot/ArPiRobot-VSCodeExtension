{
	"name": "arpirobot",
	"displayName": "ArPiRobot",
	"description": "VSCode Integration for ArPiRobot development",
	"version": "1.1.0-rc1",
	"repository": {
		"type": "git",
		"url": "https://github.com/ArPiRobot/ArPiRobot-VSCodeExtension"
	},
	"engines": {
		"vscode": "^1.38.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"files": [
		"node_modules/fs-extra/",
		"node_modules/graceful-fs/",
		"node_modules/jsonfile/",
		"node_modules/universalify/",
		"templates/",
		"out/extension.js",
		"LICENSE",
		"COPYING",
		"COPYING.LESSER"
	],
	"contributes": {
		"commands": [
			{
				"command": "arpirobot.createProject",
				"title": "ArPiRobot - Create ArPiRobot Project"
			},
			{
				"command": "arpirobot.recreatePythonEnv",
				"title": "ArPiRobot - Create Python Environment"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile",
		"test": "node ./out/test/runTest.js"
	},
	"dependencies": {
		"fs-extra": "^11.2.0"
	},
	"devDependencies": {
		"@types/glob": "^7.1.1",
		"@types/mocha": "^5.2.6",
		"@types/node": "^10.12.21",
		"@types/vscode": "^1.38.0",
		"glob": "^7.1.4",
		"mocha": "^10.2.0",
		"tslint": "^5.12.1",
		"typescript": "^3.3.1",
		"vscode-test": "^1.2.0"
	},
	"publisher": "marcusbehel"
}
