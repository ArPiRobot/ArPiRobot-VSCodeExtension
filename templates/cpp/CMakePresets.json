            "description": "Targeting aarch64 systems",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/arpirobot-aarch64-toolchain.cmake",
                "CMAKE_BUILD_WITH_INSTALL_RPATH": "ON",
                "CMAKE_BUILD_TYPE": "Release"
            },
            "environment": {},
            "vendor": {}
        }
    ],
    "buildPresets": [
        {
            "name": "armv6-debug",
            "displayName": "armv6 (Debug)",
            "configurePreset": "armv6-debug"
        },
        {
            "name": "armv6-release",
            "displayName": "armv6 (Release)",
            "configurePreset": "armv6-release"
        },

        {
            "name": "aarch64-debug",
            "displayName": "aarch64 (Debug)",
